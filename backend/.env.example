# CheapTrader backend configuration (copy to .env)

# Broker: auto | mt5 | mock
CT_BROKER=auto

# MetaTrader 5 (optional; leave blank to use the already-logged-in terminal).
# Comment these out rather than leaving them empty: CT_MT5_LOGIN is typed
# int | None, and an empty value fails validation at startup.
# CT_MT5_LOGIN=
# CT_MT5_PASSWORD=
# CT_MT5_SERVER=
# CT_MT5_PATH=
# Without CT_MT5_PATH the app looks for the installed / running MetaTrader terminals itself (the one
# you pick in the app, else a running one, else the one used last). false: leave it to the package.
# CT_MT5_AUTODETECT=true

# Safety: live order placement is disabled unless this is true
CT_ALLOW_LIVE_ORDERS=false

# Other web pages cannot use the program: it answers only requests for 127.0.0.1 / localhost and
# refuses a request that changes something (and every WebSocket) when it comes from a page of another
# address. Only needed when the page is served from somewhere else than the program itself, e.g. a
# Vite dev server that does not forward the original Host header (comma separated lists):
# CT_ALLOWED_ORIGINS=http://localhost:5173
# CT_ALLOWED_HOSTS=

# Server
CT_HOST=127.0.0.1
CT_PORT=8000
CT_BACKEND_URL=http://127.0.0.1:8000

# Live feed (app/stream): how often (seconds) the feed looks for new ticks, and for a
# change in the account or the open positions. Both are cheap reads on MetaTrader.
CT_FEED_INTERVAL=0.005
CT_STATE_INTERVAL=0.05

# MetaTrader's Python package holds Python's global lock during every call, so a slow
# one (an order waiting for the broker) would freeze the server and every price on
# screen. With this on (the default) the live feed and the trading calls each run in a
# process of their own. Turn it off only to debug.
CT_MT5_ISOLATE=true

# Mock broker only: ticks a second, and how wildly the price moves (a news spike: 40 and 3).
CT_MOCK_TICK_RATE=8
CT_MOCK_VOLATILITY=1

# Indicator sandbox
CT_INDICATOR_TIMEOUT=10
CT_INDICATOR_MEMORY_MB=2048

# Updates: look at GitHub's release list a little after the program starts and every six hours, and offer
# a newer release (also switchable in the About window; the About window's choice wins). It is the only
# connection the program makes to the internet by itself. The repository and the API address are only
# changed to try the updater against a stand-in for GitHub.
# CT_UPDATE_CHECK=true
# CT_UPDATE_REPO=REDIN14/CheapTrader
# CT_UPDATE_API=https://api.github.com
